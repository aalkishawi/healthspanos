# --- Numik HealthspanOS environment ---
# Template only. Never put real values in this file — it is committed.
# Production values live in the Vercel project settings.

# ---------------------------------------------------------------------------
# Database (REQUIRED) — Postgres everywhere, dev and prod.
# ---------------------------------------------------------------------------
# Neon: use the POOLED connection string here (host contains "-pooler").
# Local: postgresql://postgres:postgres@localhost:5432/healthspan?schema=public
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Neon serves DATABASE_URL through PgBouncer, which cannot run migrations.
# Set this to the UNPOOLED (direct) Neon string. Leave blank for a plain local
# Postgres — Prisma falls back to DATABASE_URL.
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Auth (REQUIRED)
# ---------------------------------------------------------------------------
# Session signing secret (JWT/JWS). MUST be long and random in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production-000000000000"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Launch locale ("en" launch; "ar" scaffolding present but not launch content).
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Public HTTPS URL the homepage "Launch Numik HealthspanOS" button points at.
# Leave blank locally to fall back to the in-app Member portal (/member).
# NOTE: Next INLINES every NEXT_PUBLIC_* value at BUILD time, so changing this
# without rebuilding has no effect. Use APP_BASE_URL below for email links.
NEXT_PUBLIC_APP_URL=""

# Base URL used to build links in transactional emails. Deliberately NOT a
# NEXT_PUBLIC_ variable: it is read from the live process, so promoting a build
# between environments does not keep emailing links to the old host. Falls back
# to VERCEL_URL (correct for preview deployments), then NEXT_PUBLIC_APP_URL.
APP_BASE_URL=""

# error | warn | info | debug. Defaults to info in production, debug otherwise.
LOG_LEVEL=""

# ---------------------------------------------------------------------------
# Rate limiting — Upstash Redis (OPTIONAL, strongly recommended in production)
# ---------------------------------------------------------------------------
# Without these the app falls back to an in-process limiter. That is a REAL
# limiter, not a no-op, but it is per-instance: across Vercel's many isolated
# instances an attacker can multiply their budget by fanning out. Set these in
# production. Create a database at https://console.upstash.com -> REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Error tracking — Sentry (OPTIONAL; entirely no-op when unset)
# ---------------------------------------------------------------------------
# Server + edge runtime DSN.
SENTRY_DSN=""
# Browser DSN — same value as SENTRY_DSN. Separate because only NEXT_PUBLIC_*
# variables are exposed to client code.
NEXT_PUBLIC_SENTRY_DSN=""
# Defaults to VERCEL_ENV / NODE_ENV when blank.
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# Performance trace sampling, 0.0-1.0. Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""

# ---------------------------------------------------------------------------
# Transactional email — Resend (REQUIRED for real signups)
# ---------------------------------------------------------------------------
# Without this, signup/reset/invite still WORK but no email is sent: the link is
# logged to the server console instead and the API reports delivered:false.
# That is fine locally and unacceptable in production — nobody can verify an
# address they never receive. Get a key at https://resend.com -> API Keys.
RESEND_API_KEY=""

# Verified sender. Must be on a domain you have verified in Resend, otherwise
# delivery fails. Defaults to Resend's shared onboarding sender, which is for
# testing only and should never be used in production.
EMAIL_FROM="Numik HealthspanOS <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Seeding guard
# ---------------------------------------------------------------------------
# prisma/seed.ts refuses to run unless DATABASE_URL points at localhost. Set
# this to "true" ONLY for a throwaway database such as CI. Never in production —
# production must start empty and fill from real signups.
ALLOW_SEED=""

# ---------------------------------------------------------------------------
# AI multi-model gateway (scaffolding — the live path lands in Phase 3)
# ---------------------------------------------------------------------------
# At least ONE provider key enables live answers. First configured wins, in the
# order Anthropic -> OpenAI -> Google. With none set the assistant stays in demo
# mode and says so — it never presents a placeholder as a real answer.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# OPENAI_API_KEY is additionally REQUIRED for embeddings, whichever provider
# answers. The corpus and the query must be embedded by the same model or the
# vectors are not comparable and retrieval silently returns noise.

AI_GATEWAY_DEFAULT_MODEL="demo"

# Monthly per-tenant spend ceiling in USD for model calls. Once reached, the
# assistant refuses until the calendar month rolls over. Default 25.
AI_TENANT_MONTHLY_BUDGET_USD=""

# ---------------------------------------------------------------------------
# Evidence corpus — PubMed E-utilities (no key required)
# ---------------------------------------------------------------------------
# NCBI asks that automated clients identify themselves. Optional but courteous,
# and they will contact you before blocking if something misbehaves.
NCBI_CONTACT_EMAIL=""

# Optional. Raises the NCBI rate limit from 3 to 10 requests/second, which only
# matters for large ingests. Free from https://ncbiinsights.ncbi.nlm.nih.gov
NCBI_API_KEY=""
