// Numik HealthspanOS — data model.
// Multi-tenant by design: every tenant-scoped row carries tenantId and is queried
// only through the tenant-scoping helpers in src/lib/tenant.ts.
//
// Semi-structured columns use native Postgres Json (jsonb), not stringified
// text. Text was a SQLite-era workaround: it pushed parsing to every read
// site, made malformed payloads a runtime surprise rather than a write-time
// error, and left the data unqueryable and unindexable.
//
// Postgres everywhere (Neon in production, local Postgres or a Neon branch for
// dev) so dev and prod share one engine and one migration history. Schema
// changes go through `prisma migrate dev`; `prisma/migrations/` is committed and
// `prisma migrate deploy` applies it in CI/production. Never `db push` against a
// deployed database — it drifts from the migration history.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
  // Neon pools connections via PgBouncer; migrations need a direct (non-pooled)
  // connection. Set DIRECT_URL to the unpooled Neon string. Falls back to
  // DATABASE_URL when unset, so a plain local Postgres needs no extra config.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum TenantType {
  PLATFORM // Numik itself (holds platform admins + global reviewers)
  INDIVIDUAL // B2C self-signup: one personal tenant per member (see docs/TENANCY.md)
  ENTERPRISE
  INSURER
  HEALTHCARE
  GOVERNMENT
  CLINIC
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  type      TenantType   @default(ENTERPRISE)
  status    TenantStatus @default(TRIAL)
  // White-label branding overrides: accent, logo, name.
  branding  Json?
  // Marks a synthetic/demo tenant vs. a real-data-ready tenant.
  isDemo    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users            User[]
  invitations      Invitation[]
  memberProfiles   MemberProfile[]
  aggregateMetrics AggregateMetric[]
  auditLogs        AuditLog[]

  @@index([type])
  @@index([status])
}

// Portal role model — one enum drives RBAC + navigation shells (section 6).
enum Role {
  PUBLIC // unauthenticated / marketing visitor (never persisted, used in RBAC map)
  MEMBER // Member portal — owns a Healthspan Passport
  ENTERPRISE_ADMIN // Enterprise portal — aggregate analytics only
  REVIEWER // Scientific & clinical review portal
  PLATFORM_ADMIN // Numik platform administration portal
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION // self-signup, email not yet confirmed — cannot sign in
  INVITED // B2B invite issued, password not yet set
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String     @unique
  passwordHash String
  fullName     String
  role         Role       @default(MEMBER)
  locale       String     @default("en")
  status       UserStatus @default(ACTIVE)
  // When the address was confirmed. `status` gates access; this records when and
  // survives later status changes, so it is an audit fact, not a duplicate flag.
  emailVerifiedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberProfile MemberProfile?
  reviews       ReviewApproval[]
  auditLogs     AuditLog[]
  authTokens    AuthToken[]

  @@index([tenantId])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Member portal — Healthspan Passport (real-data-ready; PHI-adjacent)
// ---------------------------------------------------------------------------

enum ConsentStatus {
  GRANTED
  PENDING
  WITHDRAWN
}

model MemberProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  tenantId      String
  dateOfBirth   DateTime?
  sex           String?
  // Consent gate: enterprises NEVER see identifiable PHI unless a legal clinical
  // workflow requires it. Aggregate analytics ignore rows without GRANTED consent.
  consent       ConsentStatus @default(PENDING)
  // Free-form intake payload (questionnaires, lifestyle history).
  // PHI: never log the contents (see src/lib/logger.ts redaction list).
  intake        Json?
  // Set when the member finishes the intake flow. Null = onboarding incomplete,
  // which is what the passport uses to decide between real data and a prompt to
  // finish — never a fabricated placeholder score.
  onboardingCompletedAt DateTime?
  // Denormalised current consent, mirroring the latest ConsentRecord so cohort
  // queries stay a single indexed predicate instead of a per-row history scan.
  consentVersion String?
  consentUpdatedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  scores         HealthspanScore[]
  actionPlans    ActionPlan[]
  consentRecords ConsentRecord[]

  @@index([tenantId])
  @@index([consent])
}

// Explainable, non-diagnostic healthspan-domain scores.
model HealthspanScore {
  id          String   @id @default(cuid())
  profileId   String
  domain      String // e.g. metabolic, cardiovascular, cognitive, sleep, activity
  score       Int // 0-100
  band        String // low | moderate | optimal
  explanation String // human-readable rationale (explainability requirement)
  computedAt  DateTime @default(now())

  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([domain])
}

enum PlanStatus {
  DRAFT
  PENDING_SAFETY_REVIEW
  APPROVED
  ACTIVE
  ARCHIVED
}

// Safe lifestyle action plans (non-diagnostic; medical/high-risk items gated).
model ActionPlan {
  id             String     @id @default(cuid())
  profileId      String
  title          String
  summary        String
  status         PlanStatus @default(DRAFT)
  // True when the plan touches medical/high-risk content requiring human approval.
  requiresReview Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Research intelligence & Scientific/Clinical review portal
// ---------------------------------------------------------------------------

enum EvidenceGrade {
  A // systematic review / RCT
  B // cohort / well-designed observational
  C // case series / mechanistic
  D // expert opinion / preliminary
  UNGRADED
}

enum EvidenceStatus {
  INGESTED
  IN_REVIEW
  APPROVED
  FLAGGED // conflicting / corrected / retracted
  REJECTED
}

// Global (platform-tenant-owned) research items surfaced to reviewers.
model EvidenceItem {
  id        String         @id @default(cuid())
  // Stable id from the upstream source, e.g. a PubMed PMID. Unique so repeated
  // ingestion updates a record rather than duplicating the literature.
  externalId String?       @unique
  sourceType EvidenceSource @default(PUBMED)
  title     String
  source    String // journal / regulator / outlet
  url       String?
  summary   String
  // Full abstract. Kept verbatim because citation verification checks that a
  // quoted span actually occurs in it — a paraphrase would defeat that.
  abstract  String?
  authors   String?
  journal   String?
  publishedAt DateTime?
  // 1536-dim embedding of title+abstract (OpenAI text-embedding-3-small).
  // Unsupported: Prisma cannot type pgvector, so similarity search is raw SQL
  // in src/lib/evidence/retrieval.ts. The column is still migrated and indexed.
  embedding Unsupported("vector(1536)")?
  embeddedAt DateTime?
  grade     EvidenceGrade  @default(UNGRADED)
  status    EvidenceStatus @default(INGESTED)
  // Retraction/conflict detection flags.
  signals   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  reviews ReviewApproval[]

  @@index([status])
  @@index([grade])
  @@index([publishedAt])
}

enum EvidenceSource {
  PUBMED
  MANUAL
  REGULATOR
}

enum ReviewDecision {
  APPROVE
  FLAG
  REJECT
  REQUEST_CHANGES
}

// Human-in-the-loop approval record for medical / high-risk content.
model ReviewApproval {
  id             String         @id @default(cuid())
  evidenceItemId String
  reviewerId     String
  decision       ReviewDecision
  notes          String?
  createdAt      DateTime       @default(now())

  evidenceItem EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([evidenceItemId])
  @@index([reviewerId])
}

// ---------------------------------------------------------------------------
// Enterprise portal — privacy-protected aggregate analytics ONLY
// ---------------------------------------------------------------------------

model AggregateMetric {
  id         String   @id @default(cuid())
  tenantId   String
  metric     String // e.g. avg_healthspan_score, participation_rate
  value      Float
  cohortSize Int // suppressed at the API layer when below k-anonymity threshold
  period     String // e.g. 2026-Q3
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, period])
}

// ---------------------------------------------------------------------------
// Cross-cutting audit trail
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Account lifecycle — verification, password reset, B2B invitations
// ---------------------------------------------------------------------------

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Single-use, expiring, HASHED credentials emailed to a user.
//
// Only the SHA-256 of the token is stored, never the token itself — the same
// reasoning as passwordHash. A database leak must not hand the attacker live
// password-reset links.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// A pending B2B membership. Exists BEFORE any User row does, so it carries the
// destination tenant and role rather than pointing at a user.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // One live invitation per address per tenant; re-inviting replaces it.
  @@unique([tenantId, email])
  @@index([email])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Consent — append-only history behind the current state on MemberProfile
// ---------------------------------------------------------------------------

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

// Immutable consent ledger. Never updated or deleted: withdrawing appends a
// WITHDRAWN row rather than mutating the GRANTED one, so the record of what a
// member agreed to, and when, survives the withdrawal. That history is the
// evidence a regulator or DPA audit asks for.
model ConsentRecord {
  id        String        @id @default(cuid())
  profileId String
  tenantId  String
  // Which consent text was agreed to, e.g. "2026-08-01". Re-consent is required
  // when this changes, so an old agreement cannot silently cover new processing.
  version   String
  action    ConsentAction
  createdAt DateTime      @default(now())

  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// AI usage metering and the assistant's safety trail
// ---------------------------------------------------------------------------

// One row per model call. Feeds per-tenant cost control now and billing later
// (Phase 5), and is the evidence for "what did this tenant actually consume".
model AiUsage {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String?
  provider         String
  model            String
  purpose          String // answer | embedding | verification
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  // Estimated, from a static price table. Marked estimated because provider
  // pricing changes and we do not reconcile against invoices.
  estimatedCostUsd Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

enum AssistantOutcome {
  ANSWERED // grounded answer returned with verified citations
  NO_EVIDENCE // nothing in the corpus supported an answer; nothing invented
  ESCALATED // individual medical question — routed to human review
  BLOCKED // unsafe or out-of-scope; refused
}

// Every assistant interaction. Exists so a clinical or regulatory review can
// reconstruct what a member asked, what the system said, and which papers it
// leaned on — the audit story for an AI that touches health questions.
//
// PHI: `question` is a member's health query. It is tenant-scoped, never logged
// to stdout, and never exposed to an enterprise tenant.
model AssistantQuery {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  question   String
  outcome    AssistantOutcome
  answer     String?
  // EvidenceItem ids actually cited, after verification dropped any the model
  // invented or could not support with a quote from the abstract.
  citedIds   String[]         @default([])
  // Citations the model produced that FAILED verification. Kept deliberately:
  // a rising count here is the early warning that the model is fabricating.
  rejectedCitations Int       @default(0)
  model      String?
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@index([outcome])
}
